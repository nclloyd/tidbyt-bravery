"""
Applet: Lloyd Holidays
Summary: Holiday greetings
Description: An animated holiday character with a three-line greeting, shown on US holidays.
"""

load("render.star", "render")
load("encoding/base64.star", "base64")

# Generated by build.py from sprites/*.gif — edit holiday.star.tmpl, not holiday.star.
# @SPRITES@

GOLD = "#FFD23C"
WHITE = "#FFFFFF"

HOLIDAYS = {
    "thanksgiving": {
        "sprite": TURKEY,
        "lines": ["HAPPY", "TURKEY DAY", "LLOYDS!"],
        "colors": [GOLD, WHITE, GOLD],
    },
}

def main(config):
    holiday = HOLIDAYS.get(config.get("holiday", "thanksgiving"), HOLIDAYS["thanksgiving"])

    text_rows = []
    for i, line in enumerate(holiday["lines"]):
        if i > 0:
            text_rows.append(render.Box(width = 1, height = 3))
        text_rows.append(render.Text(content = line, font = "CG-pixel-3x5-mono", color = holiday["colors"][i]))

    return render.Root(
        delay = 110,
        child = render.Stack(
            children = [
                render.Padding(pad = (1, 5, 0, 0), child = render.Image(src = holiday["sprite"])),
                render.Padding(
                    pad = (20, 0, 0, 0),
                    child = render.Box(
                        width = 44,
                        height = 32,
                        child = render.Column(cross_align = "center", children = text_rows),
                    ),
                ),
            ],
        ),
    )
